rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User memberships collection
    match /memberships/{uid} {
      allow read, write: if request.auth != null;
    }

    // Tenant-isolated organizations hierarchy (Vouchers, Campuses, Petty Cash, COA, Audit)
    match /organizations/{clientId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // System-wide registries and configuration
    match /system_state/{docId} {
      allow read, write: if true;
    }

    // Login activity audit log
    match /campus_login_activities/{activityId} {
      allow read, write: if true;
    }

    // General collections
    match /{collection}/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
