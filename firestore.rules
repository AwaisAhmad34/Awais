rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read: if true;
    }
    match /campuses/{campusId} {
      allow read, write: if true;
    }
    match /vouchers/{voucherId} {
      allow read, write: if true;
    }
    match /petty_cash/{pettyCashId} {
      allow read, write: if true;
    }
    match /activity_logs/{logId} {
      allow read, write: if true;
    }
    match /bank_reconciliations/{txId} {
      allow read, write: if true;
    }
    match /cash_reconciliations/{recId} {
      allow read, write: if true;
    }
    match /system_state/{docId} {
      allow read, write: if true;
    }
  }
}
