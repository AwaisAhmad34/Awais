rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Prototype, to be verified against the named production database before release.
    // memberships/{uid}: active server-provisioned membership with permissionLevel,
    // clientId and optional campusId. It contains PII: only its owner can read it.
    // organizations/{clientId}: tenant metadata; subcollections hold financial data.
    // All writes use the authenticated /api/tenants Admin SDK handlers. Browser
    // writes cannot enforce transactional voucher numbering, balance or audit rules.
    function active() {
      return request.auth != null
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && membership().status == 'active';
    }
    function membership() {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data;
    }
    function platform() {
      return active() && membership().permissionLevel == 'level_1_platform_super_admin';
    }
    function tenant(clientId) {
      return active() && (platform() || membership().clientId == clientId);
    }
    function manager(clientId) {
      return tenant(clientId) && (platform()
        || membership().permissionLevel == 'level_2_client_super_admin');
    }
    function campus(clientId, campusId) {
      // Broader main-campus delegation is resolved by the trusted API; direct
      // browser reads are limited to the assigned campus or tenant manager.
      return manager(clientId) || (tenant(clientId) && membership().campusId == campusId);
    }
    match /memberships/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /organizations/{clientId} {
      allow read: if tenant(clientId);
      allow write: if false;
      match /campuses/{campusId} {
        allow read: if campus(clientId, campusId);
        allow write: if false;
      }
      match /vouchers/{id} {
        allow read: if campus(clientId, resource.data.campusId);
        allow write: if false;
      }
      match /petty_cash/{id} {
        allow read: if campus(clientId, resource.data.campusId);
        allow write: if false;
      }
      match /{collection}/{id} {
        allow read: if manager(clientId) && collection in [
          'account_heads', 'audit', 'trash', 'settings', 'periods', 'invoices',
          'cash_reconciliations', 'bank_reconciliations', 'cash_balances'
        ];
        allow write: if false;
      }
    }
    // Global registries may include every client's contact information. Route
    // access through the API instead of exposing the shared document to tenants.
    match /system_state/{id} {
      allow read: if platform();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
