rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User memberships collection
    match /memberships/{uid} {
      allow read, write: if request.auth != null;
    }

    // Tenant-isolated organizations hierarchy (Vouchers, Campuses, Petty Cash, COA, Audit)
    match /organizations/{clientId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // System-wide registries: platform_owner_registry cannot be written by clients (Admin SDK only)
    match /system_state/platform_owner_registry {
      allow read: if true;
      allow write: if false;
    }

    match /system_state/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Login activity audit log: append-only, tamper-proof
    match /campus_login_activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if false;
    }

    // General collections
    match /{collection}/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
