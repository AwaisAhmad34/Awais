rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-tenant ERP Collections: Real-time cross-browser dynamic synchronization
    match /{collection}/{id} {
      allow read, write: if collection in [
        'campuses', 'vouchers', 'petty_cash', 'activity_logs',
        'bank_reconciliations', 'cash_reconciliations', 'system_state',
        'expense_patterns', 'global_recycle_bin', 'recovery_audit_trail',
        'platform_security_audits', 'system_backups', 'approval_matrices',
        'campus_login_activities', 'memberships'
      ];
    }

    match /memberships/{uid} {
      allow read, write: if true;
    }

    match /system_state/{docId} {
      allow read, write: if true;
    }

    match /organizations/{clientId}/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
