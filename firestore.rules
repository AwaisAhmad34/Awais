rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function active() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.status == 'active';
    }
    function profile() {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data;
    }
    function owner() {
      return active() && profile().permissionLevel == 'level_1_platform_super_admin';
    }
    // Membership creation, role changes and suspension use the Admin SDK only.
    match /memberships/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || owner());
      allow write: if false;
    }
    // Existing unscoped data is quarantined to the site owner until backed up,
    // assigned explicit tenant IDs and migrated. No client receives the master snapshot.
    match /{collection}/{id} {
      allow read, write: if collection in [
        'campuses', 'vouchers', 'petty_cash', 'activity_logs',
        'bank_reconciliations', 'cash_reconciliations', 'system_state',
        'expense_patterns', 'global_recycle_bin', 'recovery_audit_trail',
        'platform_security_audits', 'system_backups', 'approval_matrices'
      ] && owner();
    }
    // Legacy plaintext credential documents are deliberately inaccessible.
    match /campus_credentials/{id} { allow read, write: if false; }
    match /organizations/{clientId}/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
